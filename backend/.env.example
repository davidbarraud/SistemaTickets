# Copiar a .env y completar. No versionar .env.

# Conexión a MySQL (XAMPP). Formato: mysql://USUARIO:CLAVE@localhost:3306/soporte_tickets
DATABASE_URL="mysql://USUARIO:CLAVE@localhost:3306/soporte_tickets"

# OAuth Client ID de Google Cloud Console (tipo "Aplicación web")
GOOGLE_CLIENT_ID=""

# Secreto para firmar los JWT de la API (cadena larga y aleatoria)
JWT_SECRET=""
JWT_EXPIRES_IN="8h"

# Emails con rol OPERADOR, separados por coma
OPERATOR_EMAILS=""

PORT=3000
FRONTEND_ORIGIN="http://localhost:5173"
